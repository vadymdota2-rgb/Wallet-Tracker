# Зависимости и кэши сборки
node_modules/
.vite/
dist/

# Секреты — ни один файл с ними в репозиторий не попадает
.env
.env.*
# Базы с данными людей — тем более: им место на сервере, не в git
*.db
*.db-journal
*.db-wal
*.db-shm
*.pem
*.key

# Мусор инструментов
__pycache__/
*.py[cod]
npm-debug.log*
yarn-error.log*
logos.log

# Архивы: исходники живут файлами, а не тарболами
*.tar.gz
*.zip

# Редакторы и файловые менеджеры
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
