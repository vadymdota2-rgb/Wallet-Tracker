[Unit]
Description=Whale Tracker Mini App API
After=network.target whalescanner.service

[Service]
Type=simple
User=vadymdota2
WorkingDirectory=/home/vadymdota2/WalletTracker
Environment=WHALE_API_PORT=8090
# nginx живёт в Cloud Run, а служба — на этой машине: между ними интернет,
# поэтому порт обязан слушать наружу. Закрывают его WHALE_API_KEY (без
# заголовка API отвечает 403) и firewall — открой 8090 только для адресов
# Cloud Run. Если однажды nginx переедет на эту же машину, ставь 127.0.0.1.
Environment=WHALE_API_HOST=0.0.0.0
Environment=WHALE_API_ORIGIN=https://wallet-tracker-git-606699497037.europe-west1.run.app
Environment=WHALE_API_INITDATA_TTL=86400
Environment=WHALE_API_RPM=120
Environment=WHALE_DB=/home/vadymdota2/WhaleScanner/whale_bot.db
Environment=WHALE_HL_DB=/home/vadymdota2/WhaleScanner/hyperliquid.db
EnvironmentFile=/etc/whale-api.env
ExecStart=/usr/bin/python3 /home/vadymdota2/WalletTracker/whale_api.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/vadymdota2/WhaleScanner /home/vadymdota2/WalletTracker
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=768M
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
