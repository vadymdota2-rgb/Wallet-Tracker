[Unit]
Description=Whale Tracker Mini App API
After=network.target whalescanner.service

[Service]
Type=simple
User=vadymdota2
WorkingDirectory=/home/vadymdota2/WalletTracker
Environment=WHALE_API_PORT=8090
# nginx — на этой же машине (tools/vps_nginx.py), поэтому порт слушает только
# её саму: снаружи к API не подойти. Если nginx окажется на другой машине
# (как раньше в Cloud Run) — 0.0.0.0, WHALE_API_KEY и firewall, открытый
# только её адресам.
Environment=WHALE_API_HOST=127.0.0.1
Environment=WHALE_API_ORIGIN=https://wallettracker.pl
Environment=WHALE_API_INITDATA_TTL=86400
Environment=WHALE_API_RPM=120
Environment=WHALE_DB=/home/vadymdota2/WhaleScanner/whale_bot.db
Environment=WHALE_HL_DB=/home/vadymdota2/WhaleScanner/hyperliquid.db
EnvironmentFile=/etc/whale-api.env
ExecStart=/usr/bin/python3 /home/vadymdota2/WalletTracker/whale_api.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/vadymdota2/WhaleScanner /home/vadymdota2/WalletTracker
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
CapabilityBoundingSet=
LockPersonality=yes
MemoryMax=1536M
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
