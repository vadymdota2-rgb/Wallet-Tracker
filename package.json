{
  "name": "wallet-tracker-miniapp",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p .",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck:halving": "node tools/typecheck-halving.mjs",
    "typecheck:etf": "node tools/typecheck-etf.mjs",
    "typecheck:dom": "node tools/typecheck-dom.mjs",
    "clean": "node tools/clean-build.mjs",
    "build": "tsc -p . && npm run clean && vite build",
    "preview": "vite preview",
    "i18n": "python3 tools/sync-i18n.py",
    "test": "node --test tests/*.test.ts && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:e2e": "node --test tests/e2e/*.test.ts"
  },
  "dependencies": {
    "@tonconnect/ui": "^3.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@ton/core": "^0.63.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "1.56.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  }
}
